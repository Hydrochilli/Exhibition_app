{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",  
    "moduleResolution": "NodeNext",  
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "allowJs": true
  },
  "include": ["src"],
  "ts-node": {
    "transpileOnly": true
  }
}
